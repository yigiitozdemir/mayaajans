// Maya Ajans ekip programı — Cloudflare Worker ayarları
{
  "name": "maya-ekip",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "7c415dad4c10378684d95d1776bb038a",

  // Web arayüzü Worker'a gömülüdür (scripts/embed-static.mjs → src/static.gen.ts)

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maya-ekip",
      "database_id": "3d4d11ea-c158-4ad4-825c-d12c47cbabaa",
      "migrations_dir": "migrations"
    }
  ],

  // Dosyalar: Mac uygulaması güncellemeleri (desktop/…), sonra logolar ve profil fotoğrafları
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "maya-ekip-dosyalar" },
    // Haftalık veritabanı yedekleri (yalnızca sunucu yazar; dışarıya kapalı)
    { "binding": "BACKUP", "bucket_name": "maya-ekip-yedek" }
  ],

  // iPhone / tarayıcı bildirimleri (Web Push) — açık anahtar burada, gizli anahtar `wrangler secret` ile
  "vars": { "VAPID_PUBLIC": "" },

  // Canlı güncelleme merkezi (WebSocket). Ücretsiz planda SQLite tabanlı Durable Object.
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],

  // Saatlik: okunmamış atama hatırlatması + sabah özeti · 13:30 UTC = 16:30 İstanbul: yarın çekim var
  // Dakikalık: Ajandam anımsatıcıları · Pazartesi 03:17 İstanbul: haftalık yedek
  "triggers": { "crons": ["5 * * * *", "30 13 * * *", "* * * * *", "17 0 * * 1"] },

  "routes": [{ "pattern": "ekip.mayaajans.net", "custom_domain": true }],

  "observability": { "enabled": true }
}
